# Optional: a secure form endpoint for the consultation form.
# When set, the form POSTs JSON to this endpoint instead of opening a mailto draft.
# Never put API keys or secrets here; client-side env vars are public.
VITE_FORM_ENDPOINT=

# Preview marker. Leave unset to show the "Preview by Captura" badge.
# Set to "off" to remove it, which is what a production handoff should do.
VITE_PREVIEW=
